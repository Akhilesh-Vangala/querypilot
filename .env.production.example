# Copy locally only. Replace values using your secrets manager.
APP_ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://querypilot_app:REPLACE@HOST:5432/querypilot?sslmode=require
WAREHOUSE_DATABASE_URL=postgresql+psycopg://querypilot_reader:REPLACE@HOST:5432/querypilot?sslmode=require
JWT_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
AUTO_CREATE_SCHEMA=false
SEED_DEMO=false
DEMO_ACCOUNTS=false
EMBEDDED_WORKER=false
PUBLIC_DEMO=false
ALLOWED_ORIGINS=https://YOUR_APP_HOST
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ALLOW_LIVE_AI=false
# Optional private OTLP HTTP collector. Never log/export SQL, rows or prompts.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=querypilot
