# Native local development. Compose uses isolated synthetic defaults separately.
APP_ENVIRONMENT=development
DATABASE_URL=sqlite:///./.tools/querypilot-local.db
JWT_SECRET=local-development-secret-change-before-hosting-0000000000
AUTO_CREATE_SCHEMA=true
SEED_DEMO=true
DEMO_ACCOUNTS=true
EMBEDDED_WORKER=true
PUBLIC_DEMO=false
ALLOWED_ORIGINS=http://localhost:3007,http://127.0.0.1:3007
# Explicit opt-in only. Do not commit credentials or paste them in chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ALLOW_LIVE_AI=false
MAX_MODEL_ROUNDS=8
MAX_SQL_ATTEMPTS=3
MAX_RESULT_ROWS=500
STATEMENT_TIMEOUT_MS=8000
MAX_RUN_TOKENS=24000

# Optional owner-isolated account workspace; apply infrastructure/supabase migration first.
# QUERY_SUPABASE_URL=https://your-project.supabase.co
# QUERY_SUPABASE_PUBLISHABLE_KEY=
QUERY_ACCOUNT_SIGNUP=0
# Stable private report-signing secret, 48+ characters; keep out of source control.
# QUERY_REPORT_SIGNING_KEY=
