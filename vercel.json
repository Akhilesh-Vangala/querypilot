{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm ci --prefix frontend && npm run build --prefix frontend",
  "functions": {
    "index.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/app/**,frontend/dist/**}",
      "excludeFiles": "{backend/tests/**,artifacts/**,docs/**,.tools/**,frontend/node_modules/**,frontend/src/**}"
    }
  }
}
